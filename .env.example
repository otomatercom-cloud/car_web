# ───────── Public (safe for the browser) ─────────
NEXT_PUBLIC_APP_NAME=Car Wash Management
NEXT_PUBLIC_APP_URL=https://carwash.example.com

# ───────── Odoo connection (server-side only) ─────────
# Only the site URL and database name are "configuration".
ODOO_URL=https://erp.example.com
ODOO_DB=carwash_db

# Server-side secrets. NEVER prefix these with NEXT_PUBLIC_.
# ODOO_API_KEY: API key of a dedicated Odoo user ("carwash_api") that belongs to the
# "Car Wash / Manager" group. Create it in Odoo: Preferences > Account Security > New API Key.
ODOO_API_KEY=
# SESSION_SECRET: >= 32 random chars used to sign the login cookie (openssl rand -base64 48)
SESSION_SECRET=

# ───────── Behaviour ─────────
# Live-operations polling interval in ms (clamped to 2000-60000)
OPERATIONS_REFRESH_INTERVAL=5000
# Odoo request timeout in ms
ODOO_TIMEOUT=20000

# Optional. Only set to "false" when serving over plain http (e.g. a LAN test box). Leave unset behind HTTPS.
# COOKIE_SECURE=false

# Telegram webhook (customer notifications). NEXT_PUBLIC_APP_URL must be https.
TELEGRAM_WEBHOOK_SECRET=change-me-16-chars-min
